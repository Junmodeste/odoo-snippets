<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action planifiée : appelle une méthode @api.model une fois par jour -->
    <record id="snippet_book_cron_low_stock" model="ir.cron">
        <field name="name">Snippets: flag books to restock</field>
        <field name="model_id" ref="model_snippet_book"/>
        <field name="state">code</field>
        <field name="code">model._cron_flag_low_stock()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Odoo 17 : numbercall vaut 1 par défaut (une seule exécution) ; -1 = sans limite -->
        <field name="numbercall">-1</field>
    </record>
</odoo>
