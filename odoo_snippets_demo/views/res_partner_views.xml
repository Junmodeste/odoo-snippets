<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Héritage de vue : inherit_id + xpath pour insérer le champ après le n° de TVA -->
    <record id="view_partner_form_inherit_snippets" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.snippets</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="favorite_book_id"/>
            </xpath>
        </field>
    </record>
</odoo>
