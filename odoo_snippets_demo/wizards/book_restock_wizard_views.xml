<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="snippet_book_restock_wizard_view_form" model="ir.ui.view">
        <field name="name">snippet.book.restock.wizard.form</field>
        <field name="model">snippet.book.restock.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="book_ids" widget="many2many_tags"/>
                    <field name="quantity"/>
                </group>
                <footer>
                    <button name="action_restock" type="object" string="Restock" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- binding_model_id : l'assistant apparaît dans le menu Action de la liste des livres -->
    <record id="snippet_book_restock_wizard_action" model="ir.actions.act_window">
        <field name="name">Restock</field>
        <field name="res_model">snippet.book.restock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_snippet_book"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
