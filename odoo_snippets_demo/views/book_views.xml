<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 : <list> remplace <tree> -->
    <record id="snippet_book_view_list" model="ir.ui.view">
        <field name="name">snippet.book.list</field>
        <field name="model">snippet.book</field>
        <field name="arch" type="xml">
            <list decoration-danger="stock_status == 'out'" decoration-warning="stock_status == 'low'">
                <field name="name"/>
                <field name="isbn"/>
                <field name="author_id"/>
                <field name="price"/>
                <field name="quantity"/>
                <field name="total_value" sum="Total"/>
                <field name="stock_status"/>
            </list>
        </field>
    </record>

    <record id="snippet_book_view_form" model="ir.ui.view">
        <field name="name">snippet.book.form</field>
        <field name="model">snippet.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Attributs directs invisible / readonly (plus de attrs/states) -->
                    <div class="alert alert-warning" role="alert" invisible="not needs_restock">
                        This book needs to be restocked.
                    </div>
                    <field name="needs_restock" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="isbn"/>
                            <field name="author_id"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="quantity"/>
                            <field name="total_value"/>
                            <field name="stock_status" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="snippet_book_view_search" model="ir.ui.view">
        <field name="name">snippet.book.search</field>
        <field name="model">snippet.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="isbn"/>
                <filter name="needs_restock" string="To Restock" domain="[('needs_restock', '=', True)]"/>
                <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
            </search>
        </field>
    </record>

    <record id="snippet_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">snippet.book</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
